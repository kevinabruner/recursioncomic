<?php

/**
 * @file
 * Functions to support theming in your custom theme.
 */

use Drupal\Core\Site\Settings;

/**
 * Implements hook_preprocess_html().
 */
function comic_preprocess_html(&$variables) {
  // Pulls 'umami_website_id' directly from settings.php
  $variables['umami_website_id'] = Settings::get('umami_website_id', '');
}